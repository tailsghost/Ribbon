<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Ribbon.ViewModels">

    <Style x:Key="RibbonButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#CCCCCC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#2D6FB2" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="#2B2B2B" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="Foreground" Value="#EEEEEE" />
    </Style>

    <DataTemplate DataType="{x:Type vm:RibbonGroupViewModel}">
        <Border
            Margin="4"
            Padding="6"
            Background="#1F1F1F"
            CornerRadius="4">
            <StackPanel Width="160">
                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Foreground="#DDDDDD"
                    Text="{Binding Header}" />
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RibbonButtonViewModel}">
                            <ToggleButton
                                MinWidth="60"
                                MinHeight="60"
                                Margin="2"
                                Command="{Binding Command}"
                                CommandParameter="{Binding CommandParameter}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive}"
                                Style="{StaticResource RibbonButtonStyle}">
                                <ToggleButton.Content>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter Content="{Binding Icon}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Text="{Binding Header}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>