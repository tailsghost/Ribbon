<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Ribbon.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />


    <Style x:Key="RibbonButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource TabBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TabForeground}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Padding="4,2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabBorderHover}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBackgroundChecked}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabForegroundChecked}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabForegroundDisabled}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style
        x:Key="RibbonTabToggleStyle"
        BasedOn="{StaticResource RibbonButtonStyle}"
        TargetType="ToggleButton">

        <Setter Property="Background" Value="{DynamicResource TabBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TabForeground}" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Padding="6,4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBackgroundHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabForegroundHover}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBackgroundChecked}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabForegroundChecked}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabForegroundDisabled}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:RibbonGroupViewModel}">
        <Border Margin="1,0,0,2" Background="{DynamicResource GroupBackground}">
            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">

                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RibbonButtonViewModel}">
                            <ToggleButton
                                MinWidth="60"
                                MinHeight="60"
                                Padding="2"
                                Command="{Binding Command}"
                                CommandParameter="{Binding CommandParameter}"
                                Cursor="Hand"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                IsEnabled="{Binding IsActive}"
                                Style="{StaticResource RibbonButtonStyle}"
                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">

                                <ToggleButton.Content>
                                    <Grid MaxWidth="120">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="21"
                                            Height="21"
                                            Margin="1,0"
                                            Source="{Binding Icon}"
                                            Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Icon}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Text="{Binding Header}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </ToggleButton.Content>

                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Margin="1"
                    Background="{DynamicResource TabBackground}"
                    BorderBrush="Beige"
                    BorderThickness="0,0.5,0,0">
                    <TextBlock
                        Padding="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TabForeground}"
                        Text="{Binding Header}" />
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>