<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TabBackground" Color="#222222" />
    <SolidColorBrush x:Key="TabBackgroundHover" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TabBackgroundChecked" Color="#2D6FB2" />
    <SolidColorBrush x:Key="TabBackgroundDisabled" Color="#111111" />

    <SolidColorBrush x:Key="TabForeground" Color="#EEEEEE" />
    <SolidColorBrush x:Key="TabForegroundHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabForegroundChecked" Color="White" />
    <SolidColorBrush x:Key="TabForegroundDisabled" Color="#777777" />

    <SolidColorBrush x:Key="TabBorder" Color="#3C3C3C" />
    <SolidColorBrush x:Key="TabBorderHover" Color="#CCCCCC" />

    <SolidColorBrush x:Key="GroupBackground" Color="#1F1F1F" />

</ResourceDictionary>